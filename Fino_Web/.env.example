# ── Fino_Web environment ─────────────────────────────────────────────────────
# Copy to ".env" and adjust as needed. All keys are optional with sane defaults.
#
# RESALE / WHITE-LABEL: for a DEPLOYED (built) copy, do NOT rebuild to change the API
# URL or AES key/IV — edit "config.json" next to index.html instead (see public/config.json):
#     { "apiUrl": "https://api.yourclient.com/api/", "encKey": "<32 chars>", "encIv": "<16 chars>" }
# config.json wins over the VITE_* values below; leave a config.json field blank to fall back
# to these build-time defaults. The .env values here are mainly for local DEV.

# DEV (recommended): call the backend directly. The Vite dev proxy mishandles POST
# bodies on Vite 8, so we bypass it. Backend dev "http" profile = http://localhost:5266.
# Backend CORS allows any origin in Development, so this works from any dev port.
VITE_API_URL=http://localhost:5266/api/#https://api.ripay.co.in/api/ #http://localhost:5266/api/

# (Alternative, currently flaky) Vite proxy mode: unset VITE_API_URL and set the target:
# VITE_PROXY_TARGET=http://localhost:5266

# PROD / direct: absolute API base. MUST end with /api/
# VITE_API_URL=https://api.yourdomain.com/api/

# AES-256 key/IV — only override if the backend Encryption settings change.
# Defaults already match Fino_API appsettings.json.
# VITE_ENC_KEY=Talk2m@FintechApp@SecretKey32Chr
# VITE_ENC_IV=FintechApp@16Byt
