# Call the Fino_API backend directly (the Vite dev proxy mishandles POST bodies on
# this setup). Backend dev "http" profile listens on http://localhost:5266.
# CORS is open for any origin in Development, so this works from any dev port.
VITE_API_URL=http://localhost:5266/api/#https://api.ripay.co.in/api/ #

# AES transport key/IV — MUST match Fino_API appsettings "Encryption". These are
# per-deployment (white-label) values; each reseller ships its own unique pair.
VITE_ENC_KEY=Nx7pQ2sVbY8mK4wR9tE1uH6zC3jL5dA0
VITE_ENC_IV=Fp3Kd9Xm2Qs7Vb1L
