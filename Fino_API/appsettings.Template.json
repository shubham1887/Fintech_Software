// ===========================================================================
//  Fino API — settings template.
//
//  appsettings.json itself is git-ignored (it holds real credentials on each
//  machine), so this committed copy is where the shape of the configuration
//  lives. Copy it to appsettings.json for local development and fill in the
//  blanks.
//
//  A deployed installation does NOT use this file for anything that matters:
//  deploy/Install-Fino.ps1 writes appsettings.Production.json with that
//  client's own connection string, JWT secret and AES key/IV, and those
//  override everything here. Every installation must have its own keys.
// ===========================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Which browser origins may call this API. Development ignores this and allows any origin
  // (the UI dev server's port moves). "*" keeps the old open behaviour — the installer replaces
  // it with the panel's real origin(s), e.g. [ "https://panel.client.com" ]. Cookies/JWT ride on
  // these calls, so an open list in production lets any site a signed-in operator visits drive
  // the panel as them.
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  // First-run database setup, performed by Helpers/DatabaseBootstrapper.cs at startup.
  //   AutoSetup — create the database if missing and apply Scripts/install/*.sql once each
  //               (tracked in __FinoInstallHistory). Off by default so an existing production
  //               server never changes schema just because it restarted; the installer turns it on.
  //   SeedAdmin — create the first administrator from the Bootstrap values below, and only when
  //               the database has no admin yet. An existing admin is never modified.
  "Database": {
    "AutoSetup": false,
    "SeedAdmin": true
  },
  // Used once, on an empty database, to create the first login. The installer writes these and
  // then blanks the password. Never a way to reset an existing admin's password.
  "Bootstrap": {
    "BrandName": "",
    "AdminName": "",
    "AdminMobile": "",
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FinoApp;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;Command Timeout=0;"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "FintechApp",
    "Audience": "FintechAppUsers",
    "ExpiryInMinutes": "1440"
  },
  "Encryption": {
    "Key": "",
    "IV": ""
  },
  "Cache": {
    "ExpiryTimeInMinutes": 30
  },
  // B2B (API-user) gateway. Security applies to the signed /api/v1/dmt endpoints.
  //   RequireSignature   — refuse an unsigned DMT request. Turn off ONLY to let an existing
  //                        partner finish their integration; a signature that IS sent is always
  //                        verified either way, so nobody is silently downgraded.
  //   ClockSkewSeconds   — how far a request's timestamp may sit from server time (each way).
  //   NonceTtlSeconds    — how long a spent nonce is remembered. Leave at 0 to derive it from the
  //                        skew window (2× + 60s), which is the shortest value that is still safe.
  // Dmt limits are a brake at the API edge, applied ON TOP OF wallet balance, slab limits and the
  // per-sender monthly cap — not a replacement for any of them.
  "ApiUser": {
    "Security": {
      "RequireSignature": true,
      "ClockSkewSeconds": 300,
      "NonceTtlSeconds": 0
    },
    "Dmt": {
      "MinAmount": 100,
      "MaxAmount": 25000,
      "SenderMonthlyLimit": 25000
    },
    // Payout carries the API user's own funds, so there is no remitter and no regulatory
    // per-sender cap — only the per-transfer floor and ceiling apply.
    "Payout": {
      "MinAmount": 1,
      "MaxAmount": 200000
    }
  },
  // Automated settlement sweeps, scheduled by Hangfire (Helpers/HangfireSetup.cs). Enabled=false
  // removes the recurring jobs entirely. DashboardEnabled exposes /hangfire; it defaults to
  // development only and is restricted to loopback requests elsewhere, since the dashboard can
  // trigger and delete jobs.
  "StatusCheck": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "MinAgeSeconds": 90,
    "BatchSize": 50,
    "MaxParallel": 4,
    "Workers": 4,
    "DashboardEnabled": false
  },
  // The morning outstanding reminder: everyone still carrying a balance is texted what they owe.
  // "Morning" is local, so the hour is configuration rather than code - an install serving one
  // state wants it before the counter opens, and that is not the same clock time everywhere this
  // product is sold. Standard five-field cron, server time. Set ReminderEnabled false to stop the
  // reminders without switching the whole cash-collection feature off (which is a Key Setting).
  "CashCollection": {
    "ReminderEnabled": true,
    "ReminderCron": "0 9 * * *"
  },
  "EInvoice": {
    // The Invoice Registration Portal. Leave Enabled false until this client is on e-invoicing:
    // the not-configured default then stays wired in and fails loudly, which is correct. To turn
    // the real gateway on, set Enabled true and fill in the GSP (or NIC) details below — no rebuild.
    // The alert sweeps run regardless; the queue processor runs only when this is configured.
    "Enabled": false,
    "BaseUrl": "",
    "AuthPath": "",
    "GeneratePath": "/eicore/v1.03/Invoice",
    "ClientId": "",
    "ClientSecret": "",
    "Gstin": "",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "AuthTokenHours": 6,
    "ScheduleEnabled": true,
    "ProcessIntervalMinutes": 30,
    "ProcessBatchSize": 100,
    "AlertCron": "0 7 * * *",
    "AlertDaysAhead": 7
  },
  "FCM": {
    // Firebase Cloud Messaging HTTP v1. The legacy server-key API this used before was
    // switched off by Google in June 2024, which is why pushes stopped arriving.
    // Download a service-account JSON from Firebase Console -> Project settings ->
    // Service accounts, then either point ServiceAccountFile at it or paste it into
    // ServiceAccountJson. Leave both blank and alerts still work - they just show in
    // the app bell instead of the phone tray.
    "ProjectId": "",
    "ServiceAccountFile": "",
    "ServiceAccountJson": "",
    // Optional. Only needed when this API is reached on a different public hostname than the
    // one the app pool sees (a reverse proxy, or a CDN in front of /uploads). Left blank, an
    // alert image is made absolute against the host of the request that published it, which is
    // correct for an ordinary single-host install.
    "PublicBaseUrl": ""
  },
  "PlanApi": {
    "BaseUrl": "https://planapi.in/api/Mobile",
    "MemberId": "",
    "Password": "",
    "OperatorCodes": {}
  },
  "JaiJuiApi": {
    "BaseUrl": "https://api.jaijuirecharge.in/DMT/v1"
  },
  // Pay1 Utility / BBPS (recharges.pay1.in). Endpoint and timeout only.
  // partner_id and the Access Key live on the "API Providers" row, NOT here:
  //   ProviderMaster.LoginID -> partner_id (P0232050)
  //   ProviderMaster.Token   -> Access Key (the SALT; hashed into hash_code, never sent)
  // so the key can be rotated from the panel without a redeploy.
  "Pay1Api": {
    "BaseUrl": "https://recharges.pay1.in",
    "TimeoutSeconds": 60
  },
  // Nexmint payout / fund transfer (api.nexmint.in). Endpoint, sandbox switch and timeout only.
  // client_id and client_secret live on the "API Providers" row, NOT here:
  //   ProviderMaster.LoginID          -> ClientID      (client-id header)
  //   ProviderMaster.Token            -> ClientSecret  (signs both JWTs, HS256, 5-second lifetime)
  //   ProviderMaster.ProviderUniqueID -> WebhookSecret (signs the payout callback - a DIFFERENT key)
  // so the keys can be rotated from the panel without a redeploy. UseSandbox true sends every call
  // to /sandbox, where Nexmint's fixed test accounts answer and no real money moves.
  "NexmintApi": {
    "BaseUrl": "https://api.nexmint.in/api/v1/gateway",
    "UseSandbox": false,
    "TimeoutSeconds": 60
  }
}
