<?xml version="1.0" encoding="utf-8"?>
<!-- Restores from the machine's own package cache. This box cannot always reach nuget.org, and
     the project needs no packages anyway - this only keeps restore from trying. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="C:\Users\Administrator\.nuget\packages" />
  </packageSources>
</configuration>
